# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to talk to SARAS (get yours from @userinfobot)
TELEGRAM_ALLOWED_USER_IDS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
OBSIDIAN_VAULT_PATH=C:\Users\oscar\Documents\SARAS-Vault
# Which LLM to use: gemini (default) or anthropic
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
# Optional; defaults claude-opus-5-5 / claude-haiku-4-5
ANTHROPIC_MODEL=
ANTHROPIC_FAST_MODEL=
